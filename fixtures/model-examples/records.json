    "created_at": "2026-10-26T10:00:00+05:30",
    "fields": {
      "name": "Wildlife sighting",
      "slug": "wildlife-sighting",
      "instructions": "Record any animal you see inside the study area. Photograph it before you approach, and never disturb nests or roosts. One submission per group of the same species.",
      "submit_label": "Submit a sighting",
      "idea": "olb:obj:idea-lake-edges",
      "hypothesis_ref": "olb:obj:hyp-h1-lake-edges",
      "status": "live",
      "form": [
        {
          "key": "photos",
          "type": "photo",
          "label": "Photos",
          "help": "Up to 5 clear photos of the animal.",
          "required": true,
          "config": {
            "min": 1,
            "max": 5,
            "max_mb_each": 25,
            "accept": [
              "image/jpeg",
              "image/png",
              "image/heic",
              "image/webp"
            ],
            "fill_from_exif": [
              "location",
              "datetime"
            ],
            "strip_metadata": true
          }
        },
        {
          "key": "category",
          "type": "choice",
          "label": "Category",
          "required": true,
          "config": {
            "palette": true,
            "other_allowed": false,
            "options": [
              {
                "value": "birds",
                "label": "Birds"
              },
              {
                "value": "mammals",
                "label": "Mammals"
              },
              {
                "value": "reptiles",
                "label": "Reptiles",
                "sensitive": true
              },
              {
                "value": "amphibians",
                "label": "Amphibians"
              },
              {
                "value": "insects",
                "label": "Insects"
              },
              {
                "value": "other",
                "label": "Other"
              }
            ]
          }
        },
        {
          "key": "species",
          "type": "species",
          "label": "Species",
          "help": "Leave blank if unsure; reviewers can help.",
          "required": false,
          "config": {
            "source": "project_list",
            "project_list": "logos:zb2rhSpeciesListPlaceholder",
            "filter_by_field": "category",
            "reviewers_can_suggest": true
          }
        },
        {
          "key": "count",
          "type": "number",
          "label": "Count",
          "help": "How many individuals you saw.",
          "required": true,
          "config": {
            "min": 1,
            "integer": true,
            "unit": "individuals"
          }
        },
        {
          "key": "location",
          "type": "location",
          "label": "Location",
          "help": "Where you saw it, not where you are now.",
          "required": true,
          "config": {
            "methods": [
              "photo",
              "map",
              "manual"
            ],
            "max_accuracy_m": 50,
            "study_area": "logos:zb2rhStudyAreaPlaceholder",
            "public_precision": "grid_1km"
          }
        },
        {
          "key": "observed",
          "type": "datetime",
          "label": "Date and time",
          "required": true,
          "config": {
            "fill_from": [
              "photo",
              "now"
            ],
            "no_future": true
          }
        },
        {
          "key": "behaviour",
          "type": "multi",
          "label": "Behaviour",
          "help": "Select all that apply.",
          "required": false,
          "config": {
            "options": [
              {
                "value": "feeding",
                "label": "Feeding"
              },
              {
                "value": "flying",
                "label": "Flying"
              },
              {
                "value": "nesting",
                "label": "Nesting"
              },
              {
                "value": "resting",
                "label": "Resting"
              },
              {
                "value": "calling",
                "label": "Calling"
