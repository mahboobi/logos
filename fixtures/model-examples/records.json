  {
    "id": "olb:obj:hyp-h1",
    "type": "hypothesis",
    "version": 3,
    "project": "olb:proj:wildlife",
    "authors": [
      {
        "key": "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4",
        "kind": "member",
        "name": "Nisha Kumar"
      },
      {
        "key": "b2c3d4e5b2c3d4e5b2c3d4e5b2c3d4e5b2c3d4e5b2c3d4e5b2c3d4e5b2c3d4e5",
        "kind": "member",
        "name": "Aisha Farooq"
      }
    ],
    "parents": [
      "olb:obj:hyp-h1",
      "olb:obj:idea-7"
    ],
    "created_at": "2026-08-20T09:55:00+05:30",
    "fields": {
      "label": "H1",
      "statement": {
        "format": "olb-blocks/1",
        "blocks": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Lake-edge zones record more bird species per survey hour than park-lawn zones."
              }
            ]
          }
        ]
      },
      "predictions": [
        {
          "key": "p1",
          "text": "Mean bird species per survey hour is at least 30% higher at lake edges."
        },
        {
          "key": "p2",
          "text": "The difference holds in both morning and evening surveys."
        }
      ],
      "falsification": "H1 is rejected if lake-edge species richness is not higher at alpha 0.05.",
      "analysis_plan": {
        "format": "olb-blocks/1",
        "blocks": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Species per survey hour per zone; Poisson GLM with zone and time of day; verified sightings only."
              }
            ]
          }
        ]
      },
      "based_on": [
        "olb:obj:idea-7"
      ],
      "status": "committed",
      "approvals": [
        "b2c3d4e5b2c3d4e5b2c3d4e5b2c3d4e5b2c3d4e5b2c3d4e5b2c3d4e5b2c3d4e5",
