class OlbUi
{
    // ---- Phase 0 task 3: session status ----
    SLOT(void refreshSessionStatus())

    // ---- Phase 0 task 4: signed records over Delivery ----
    SLOT(void publishTestRecord(QString title))

    // ---- Phase 0 task 5: files through Logos Storage ----
    // Absolute paths only: the module sandbox means QML never reads the file,
    // it passes a path and olb_core does the I/O (CLAUDE.md constraint 2 —
    // never pass file contents through the UI, pass CIDs and paths).
    SLOT(void uploadFile(QString absPath))
    SLOT(void fetchFile(QString cid, QString absDest))

    // ---- Phase 1a: screens ----
    SLOT(void refreshBoard())
    SLOT(void createProject(QString specJson))
    SLOT(void setCurrentProject(QString projectId))
    SLOT(void createNote(QString title, QString body))
    SLOT(void promoteNote(QString noteId, QString projectId, QString stage))
    // Add work to a project directly. Without this a project created from
    // New Project holds nothing and can never finish its first stage.
    SLOT(void createIdea(QString projectId, QString title, QString summary))
    SLOT(void saveProfile(QString name, QString orcid))
    SLOT(void openRecord(QString recordId))

    // ---- Passphrase: the store is sealed until one is given ----
    SLOT(void refreshLockState())
    SLOT(void createPassphrase(QString passphrase))
    SLOT(void unlockStore(QString passphrase))

    // ---- Phase 1c: identity and invites ----
    SLOT(void refreshIdentity())
    SLOT(void inviteMember(QString projectId, QString olbId, QString role))
    SLOT(void acceptInvite(QString inviteId))

    // ---- Auto-synced to every QML replica via QtRO ----
    // The S1 project board (docs/03), as a JSON object.
    PROP(QString board="{}" READONLY)
    PROP(bool fixtures=false READONLY)
    // JSON arrays / objects from the durable store.
    PROP(QString notes="[]" READONLY)
    PROP(QString projects="[]" READONLY)
    PROP(QString profile="{}" READONLY)
    // S6 / S7 / S2 payloads. Fixture-backed for the parts the store does not
    // model yet; olb_core says which via fixtures_enabled().
    PROP(QString history="{}" READONLY)
    PROP(QString members="{}" READONLY)
    PROP(QString openedRecord="{}" READONLY)
    // Last create/promote outcome, for inline error reporting.
    // The project's stage rides along in `board` (stage, stageName,
    // stageNeeds, stagesUsed) rather than in a PROP of its own. Every
    // backend refresh is already eight synchronous round-trips and each one
    // can wedge the UI thread (docs/08 R21), so a ninth call to say where a
    // project has got to would buy nothing and cost availability.
    PROP(QString lastActionResult="" READONLY)
    PROP(QString coreStatus="" READONLY)
    PROP(bool coreReachable=false READONLY)
    // JSON array of verified records received from peers, newest first.
    PROP(QString records="[]" READONLY)
    // This node's ed25519 signing-key fingerprint.
    PROP(QString identity="" READONLY)
    // {id, fingerprint}: the olb1: string a user copies, and the only part
    // of it a human can meaningfully check. Public halves only — a private
    // key never crosses this seam.
    // {state: needs_setup|locked|unlocked, minLength, reason}. Every data
    // PROP below is empty until this reads unlocked.
    PROP(QString lockState="{}" READONLY)
    PROP(QString myId="{}" READONLY)
    // Invites waiting on a decision. The sealed envelope is deliberately
    // NOT here; verification is not acceptance, so the UI shows who sent it
    // and waits (docs/04 §9).
    PROP(QString invites="[]" READONLY)
    // JSON array of {cid, direction} this node has uploaded or fetched.
    PROP(QString cids="[]" READONLY)
    // Last storage outcome, as the module's own JSON result envelope.
    PROP(QString lastStorageResult="" READONLY)
}
