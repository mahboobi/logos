{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlabbook.unblockresearch.com/schemas/collection-protocol.schema.json",
  "title": "Open Labbook data collection protocol (fields of a collection_protocol record)",
  "type": "object",
  "required": ["name", "slug", "status", "form", "rules"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "instructions": { "type": "string", "maxLength": 4000 },
    "submit_label": { "type": "string", "maxLength": 60, "description": "Form title, for example 'Submit a sighting'. Default 'Submit to <name>'." },
    "idea": { "type": ["string", "null"] },
    "hypothesis_ref": { "type": ["string", "null"] },
    "status": { "enum": ["draft", "live", "closed"] },
    "form": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/field" }
    },
    "rules": {
      "type": "object",
      "required": ["who", "review"],
      "additionalProperties": false,
      "properties": {
        "who": { "enum": ["members", "members_and_visitors"] },
        "review": {
          "type": "object",
          "required": ["verifications"],
          "additionalProperties": false,
          "properties": {
            "verifications": { "type": "integer", "minimum": 0, "maximum": 3 },
            "exclude_submitter": { "type": "boolean", "default": true },
            "visitors_always_reviewed": { "type": "boolean", "default": true },
            "reviewer_role_can_verify": { "type": "boolean", "default": false }
          }
        },
        "edit_window_hours": { "type": ["integer", "null"], "minimum": 0, "description": "null = until verified; 0 = never" },
        "accept_offline": { "type": "boolean", "default": true },
        "duplicate_check": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "radius_m": { "type": "number", "minimum": 1 },
            "window_minutes": { "type": "number", "minimum": 1 },
            "match_field": { "type": "string" },
            "fallback_field": { "type": "string" }
          }
        },
        "media_replication": { "enum": ["everyone_pins_all", "originals_on_replicas"], "default": "originals_on_replicas" }
      }
    },
    "dwc_mapping": {
      "type": "object",
      "description": "Field key → Darwin Core term, used by DwC-A export.",
      "additionalProperties": { "type": "string", "pattern": "^dwc:[A-Za-z]+$" }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "option": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sensitive": { "type": "boolean", "default": false }
      }
    },
    "field": {
      "type": "object",
      "required": ["key", "type", "label", "required"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "enum": ["photo", "audio", "location", "datetime", "choice", "multi", "number", "text", "longtext", "species", "yesno"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "help": { "type": "string", "maxLength": 300 },
        "required": { "type": "boolean" },
        "config": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "photo" } } }, "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": {
          "min": { "type": "integer", "minimum": 0, "maximum": 10 },
          "max": { "type": "integer", "minimum": 1, "maximum": 10 },
          "max_mb_each": { "type": "number", "minimum": 1, "maximum": 100 },
          "accept": { "type": "array", "items": { "enum": ["image/jpeg", "image/png", "image/heic", "image/webp"] } },
          "fill_from_exif": { "type": "array", "items": { "enum": ["location", "datetime"] } },
          "strip_metadata": { "const": true }
        } } } } },
        { "if": { "properties": { "type": { "const": "audio" } } }, "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": {
          "max_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
          "max_mb": { "type": "number", "minimum": 1, "maximum": 100 }
        } } } } },
        { "if": { "properties": { "type": { "const": "location" } } }, "then": { "properties": { "config": { "type": "object", "required": ["methods", "public_precision"], "additionalProperties": false, "properties": {
          "methods": { "type": "array", "minItems": 1, "items": { "enum": ["photo", "map", "manual"] } },
          "max_accuracy_m": { "type": ["number", "null"] },
          "study_area": { "type": ["string", "null"], "description": "CID of a GeoJSON FeatureCollection" },
          "public_precision": { "enum": ["exact", "grid_1km", "grid_10km", "hidden"] }
        } } } } },
        { "if": { "properties": { "type": { "const": "datetime" } } }, "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": {
          "fill_from": { "type": "array", "items": { "enum": ["photo", "now"] } },
          "no_future": { "type": "boolean" }
        } } } } },
        { "if": { "properties": { "type": { "enum": ["choice", "multi"] } } }, "then": { "properties": { "config": { "type": "object", "required": ["options"], "additionalProperties": false, "properties": {
          "options": { "type": "array", "minItems": 2, "maxItems": 50, "items": { "$ref": "#/$defs/option" } },
          "other_allowed": { "type": "boolean" },
          "min": { "type": "integer", "minimum": 0 },
          "max": { "type": "integer", "minimum": 1 },
          "palette": { "type": "boolean", "description": "Use this field's options as the data-viz category palette (max 6)." }
        } } } } },
        { "if": { "properties": { "type": { "const": "number" } } }, "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": {
          "min": { "type": "number" }, "max": { "type": "number" }, "integer": { "type": "boolean" }, "unit": { "type": "string", "maxLength": 30 }
        } } } } },
        { "if": { "properties": { "type": { "enum": ["text", "longtext"] } } }, "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": {
          "max_length": { "type": "integer", "minimum": 1, "maximum": 5000 }
        } } } } },
        { "if": { "properties": { "type": { "const": "species" } } }, "then": { "properties": { "config": { "type": "object", "additionalProperties": false, "properties": {
          "source": { "enum": ["project_list", "gbif"] },
          "project_list": { "type": ["string", "null"], "description": "CID of a species list (CSV: name, taxon_id, category)" },
          "filter_by_field": { "type": ["string", "null"] },
          "reviewers_can_suggest": { "type": "boolean" }
        } } } } }
      ]
    }
  }
}
